# Copy to .env. Never commit .env.

CODES_DOMAIN=codes.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Caddy handles HTTPS on 80/443. Using your own reverse proxy? Delete this line and target 127.0.0.1:8088.
COMPOSE_PROFILES=caddy
RELAY_PORT=8088
TZ=UTC

# Optional
CODES_REQUIRE_DMARC=1
CODES_TEST_SEND=1
# Real test emails instead of simulated codes (sender on the same domain as CODES_DOMAIN)
CODES_TEST_MAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=codes
